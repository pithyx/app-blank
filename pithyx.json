{
  "$schema": "./node_modules/@pithyx/sdk/schema/manifest.v2.schema.json",
  "manifestVersion": 2,
  "id": "com.example.blank",
  "version": "1.0.0",
  "name": {
    "en": "Blank",
    "de": "Leer"
  },
  "description": {
    "en": "The smallest Pithyx app: a window that greets the signed-in user.",
    "de": "Die kleinste Pithyx-App: ein Fenster, das den angemeldeten Nutzer begrüßt."
  },
  "author": {
    "name": "Your name"
  },
  "license": "MIT",
  "entry": "frontend/index.html",
  "sdk": "^2.0.0",
  "arch": [
    "amd64",
    "arm64"
  ],
  "source": "https://github.com/pithyx/app-blank",
  "permissions": {},
  "window": {
    "instances": "single",
    "defaultSize": {
      "width": 480,
      "height": 360
    },
    "minSize": {
      "width": 320,
      "height": 240
    }
  }
}
